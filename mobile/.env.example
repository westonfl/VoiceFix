# Copy to .env and adjust for your environment.
# Restart the Expo dev server after changing values.

# Analysis server base URL (no trailing slash)
# Local: http://127.0.0.1:8000
# Device on same network: http://<your-machine-ip>:8000
# Production: https://your-app.up.railway.app
EXPO_PUBLIC_ANALYSIS_SERVER_URL=http://127.0.0.1:8000

# RevenueCat public SDK keys (Project settings > API keys).
# These are platform-specific public keys, not a RevenueCat secret API key.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_your_public_sdk_key
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_your_public_sdk_key

# Must match the entitlement attached to your RevenueCat products.
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=pro
